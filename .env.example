# Supabase. URL + publishable key: server-side lead intake, rate limits, /verify and staff sign-in (RLS applies).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SECRET key: server only (never NEXT_PUBLIC_). Used only to store generated MOU PDFs in the private bucket.
SUPABASE_SECRET_KEY=
# Public origin used in auth e-mail links, e.g. https://blackstallion-academy.vercel.app (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# Resend e-mail. Notifications go to LEAD_NOTIFY_EMAIL (comma separated). Until the sending domain is verified in
# Resend, keep the default onboarding@resend.dev sender: it can only reach the Resend account owner, so
# LEAD_NOTIFY_EMAIL must be that owner's address. Leave RESEND_CONFIRMATIONS empty until then. After verification: RESEND_FROM="Black Stallion Academy <office@blackstallion.academy>".
RESEND_API_KEY=
RESEND_FROM=
LEAD_NOTIFY_EMAIL=
RESEND_CONFIRMATIONS=

# Formspree inbox/backup for every validated enquiry (server-side forward), e.g. https://formspree.io/f/xxxxxxx
FORMSPREE_ENDPOINT=
# Optional: notify a CRM / Zapier / e-mail hook for every lead
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
# Optional: commissioned 3D model for the hero
NEXT_PUBLIC_STALLION_MODEL=

# Trustee invitations: generate a random >=32-character secret; never expose with NEXT_PUBLIC_.
TRUSTEE_SESSION_SECRET=
# Each code must be a random >=16-character token. Store only its SHA-256 hex hash.
# Removing or expiring an invitation revokes its sessions immediately.
TRUSTEE_INVITATIONS_JSON=[]
# Example shape (replace every value; do not use a sample code):
# [{"id":"school-001","institution":"Approved school name","codeHash":"64 lowercase hex characters","expiresAt":"2026-12-31T23:59:59Z"}]

# Rate limiting (lead forms, trustee unlock, credential lookups). Server-only random secret, 32+ characters.
# Client addresses are hashed with it before they reach the database; never logged or stored in clear.
RATE_LIMIT_SALT=

# Cloudflare Turnstile anti-bot check (optional until the account exists). Set BOTH or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Search indexing. Leave empty on every preview/staging deployment; set to 1 only on the approved production site.
NEXT_PUBLIC_ALLOW_INDEXING=

# Payments (NOT USED YET: lib/payments/core.ts is tested but not connected; needs owner approval and a merchant account).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
