# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local media and reference material (not source; see scripts/fetch-media.sh and docs/)
/public/media/*.png
/public/media/*.jpg
/public/media/*.mp4
/hf_*.mp4
/Claude outputs/
/blackstallion images/
/instructions/
/*.pdf

# large local video files (not source)
/public/video/hf_*
/_to_delete/
!.env.example

# session rollback snapshots (local only)
/_session_snapshots/

# local verification artefacts and capture experiments (not application source; see docs/REPOSITORY_HYGIENE.md)
/scratch/
/output/
/.playwright-cli/
.env*.local

# motion lab: runtime and model files prepared by scripts/motion-lab-assets.mjs
/public/motion-lab/
/public/motion-lab/models/

# Motion Lab validation footage (Wikimedia Commons, see test-media/SOURCES.md)
/test-media/

# Layered Marwari scroll paintings: PNG masters (~100 MB) stay local; the site uses the WebP derivatives in
# public/images/story/marwari/journey/ (scripts/build-marwari-journey.mjs).
/public/images/story/marwari/mw*.png
# Trainer/parent campaign PNG masters stay local; the site uses the WebP derivatives beside them.
/public/images/campaign/trainer-parent/*.png
# Owner's original horse photographs (third-party sources, kept unedited); published derivatives live in public/images/horses/real/.
/real marwari horse images/
